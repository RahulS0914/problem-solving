#to find factorial of number:
def factorial(n):
    if n==0 or n==1:
        return 1
    return n*factorial(n-1)   
n=int(input("enter n: "))
print("factorial: ",factorial(n))
   
    
   
#fibonacci series
def fibonacci(n):
    if n<=1:
        return 1
    return fibonacci(n-1)+fibonacci(n-2)
n=int(input("enter n: "))
for i in range(n):
    print(fibonacci(i),end=" ")
fibonacci(n)































        
