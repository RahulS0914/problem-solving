# iii)count positive and negative number
positive=0
negative=0
zero=0
for value in numbers:
    if value>0:
        positive+=1
    elif value==0:
        zero+=1
    else:
        negative+=1
print("+ve numbers are: ",positive)
print("-ve numbers are : ",negative)
print("number of zeros are: ",zero)

