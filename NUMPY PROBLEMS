#Sum of 2 matrix
#Create two matrices using nested list
matrix1=[
[1,2,3],
[4,5,6]
]
matrix2=[
[7,8,9],
[10,11,12]
]

#initialise a result matrix with the same size
result=[
[0,0,0],
[0,0,0]
]
#perform matrix addition
for i in range(len(matrix1)):   #loop through rows
    for j in range(len(matrix1[0])):  #loop throuugh columns
        result[i][j]=matrix1[i][j]+matrix2[i][j]
#display the result
print("Matrix1: ")
for row in matrix1:
    print(row)
print("Matrix 2: ")
for row in matrix2:
    print(row)
print("Sum of matrix1 and matrix2 is: ")
for row in result:
    print(row)









